# Google Analytics 4 - Set this with your actual Measurement ID from GA4 console
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-PLACEHOLDER

# Encryption key for stored third-party credentials (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If lost, all stored OAuth tokens become unreadable and every restaurant must reconnect.
CREDENTIALS_ENCRYPTION_KEY=

# Mercado Pago OAuth (marketplace) - restaurants connect their own account.
# Mercado Pago developers panel -> your application -> App ID / Client secret.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# Public URL of this app, no trailing slash (e.g. https://app.gastrux.com.br).
# Required: NextAuth, the OAuth return URL and the Mercado Pago back_urls and
# webhook (notification) URL are all built from it. It must be an absolute http(s) URL.
NEXTAUTH_URL=

# Mercado Pago webhook signing secret: Mercado Pago developers panel -> your application ->
# Webhooks -> "Chave secreta". Every notification is HMAC-verified with it and REJECTED when it
# is missing, so no online payment (PIX or card) is ever confirmed without it.
# MERCADO_PAGO_WEBHOOK_SECRET is used by default; when MERCADO_PAGO_ENV=production,
# MERCADO_PAGO_WEBHOOK_SECRET_PROD takes precedence (falls back to the plain one).
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET_PROD=

# Bearer secret of the scheduled (cron) endpoints. POST /api/pagamentos/mp/connect/refresh
# renews the restaurants' Mercado Pago tokens and MUST be called every ~6 hours by the host's
# scheduler with "Authorization: Bearer <CRON_SECRET>" (or the x-internal-trigger header):
# there is no scheduler in this repo. Without it the tokens expire and every restaurant
# has to reconnect.
CRON_SECRET=

# Gastrux staff allowlist: comma-separated e-mails (e.g. a@x.com,b@x.com). The only identity
# allowed to act across restaurants (manage any restaurant's payment settings). Leave empty for none.
PLATFORM_ADMIN_EMAILS=

# WhatsApp Embedded Signup (Meta App Dashboard → Facebook Login for Business)
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Sentry (error tracking)
SENTRY_DSN=
