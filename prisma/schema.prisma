generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  password               String?
  image                  String?
  emailVerified          DateTime?
  role                   UserRole                @default(COOK)
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  lastSignInAt           DateTime?
  stripeCustomerId       String?
  subscriptionId         String?
  subscriptionTier       String                  @default("starter")
  subscriptionStatus     String                  @default("active")
  billingCycleStart      DateTime?
  billingCycleEnd        DateTime?
  lastInvoiceDate        DateTime?
  trialEndsAt            DateTime?
  emailSentDay3          Boolean                 @default(false)
  emailSentDay7          Boolean                 @default(false)
  emailDay3SentAt        DateTime?
  emailDay7SentAt        DateTime?
  emailVariantDay3       String?
  emailVariantDay7       String?
  emailDay3OpenedAt      DateTime?
  emailDay7OpenedAt      DateTime?
  convertedToProAt       DateTime?
  conversionSource       String?
  convertedToPlan        String?
  referralCode           String?                 @unique
  referredByUserId       String?
  referralBonusEarned    Int                     @default(0)
  referralBonusCount     Int                     @default(0)
  referralTier           String                  @default("bronze")
  currentRestaurantId    String?
  emailDay14SentAt       DateTime?
  emailDay1SentAt        DateTime?
  emailDay21SentAt       DateTime?
  emailSentDay1          Boolean                 @default(false)
  emailSentDay14         Boolean                 @default(false)
  emailSentDay21         Boolean                 @default(false)
  emailSentTrialEnding   Boolean                 @default(false)
  emailSentWelcome       Boolean                 @default(false)
  emailTrialEndingSentAt DateTime?
  emailWelcomeSentAt     DateTime?
  acceptedTermsAt        DateTime?
  notifications          Notification[]          @relation("UserNotifications")
  accounts               Account[]
  adminLogs              AdminLog[]              @relation("AdminLogsUser")
  aiInsightsCreated      AIInsight[]             @relation("userAIInsights")
  alertPreferences       AlertPreference[]
  auditLogs              AuditLog[]
  billingInvoices        BillingInvoice[]        @relation("BillingInvoiceUser")
  dailyTransactionCounts DailyTransactionCount[]
  abTestResults          EmailABTestResult[]
  emailDeliveryLogs      EmailDeliveryLog[]
  emailFeedback          EmailFeedback[]
  featureRequestsCreated FeatureRequest[]        @relation("UserFeatureRequests")
  featureVotes           FeatureVote[]           @relation("UserFeatureVotes")
  feedbackSubmitted      Feedback[]              @relation("UserFeedback")
  helpArticlesAuthored   HelpArticle[]           @relation("HelpArticleAuthor")
  orderSessions          OrderSession[]          @relation("OrderSessionUser")
  refundsProcessed       PaymentRefund[]
  referralCreatedHistory ReferralHistory[]       @relation("ReferralCreated")
  referralHistory        ReferralHistory[]
  restaurants            RestaurantUser[]        @relation("UserRestaurants")
  sessions               Session[]
  staffMember            StaffMember?            @relation("StaffMemberUser")
  subscriptions          Subscription[]
  supportMessages        SupportMessage[]        @relation("SupportMessageSender")
  supportTicketsAssigned SupportTicket[]         @relation("SupportTicketAssignedTo")
  supportTicketsOpened   SupportTicket[]         @relation("SupportTicketOpenedBy")
  surveyResponse         SurveyResponse?
  onboarding             UserOnboarding?
  referredByUser         User?                   @relation("ReferredBy", fields: [referredByUserId], references: [id])
  referrals              User[]                  @relation("ReferredBy")

  @@index([role])
  @@index([active])
  @@index([subscriptionTier])
  @@index([subscriptionStatus])
  @@index([lastSignInAt])
  @@index([createdAt])
  @@index([currentRestaurantId])
  @@map("users")
}

model UserOnboarding {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  skippedAt                DateTime?
  currentStep              Int       @default(0)
  defaultCategoriesCreated Boolean   @default(false)
  exampleRecipeCreated     Boolean   @default(false)
  modulesViewed            String    @default("")
  ingredientAdded          Boolean   @default(false)
  recipeCreated            Boolean   @default(false)
  productionPlanCreated    Boolean   @default(false)
  stockMovementRecorded    Boolean   @default(false)
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_onboarding")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model IngredientCategory {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  color        String       @default("#6366f1")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients  Ingredient[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("ingredient_categories")
}

model Ingredient {
  id                  String               @id @default(cuid())
  restaurantId        String
  code                String
  name                String
  description         String?
  categoryId          String
  standardUnit        Unit
  purchaseUnit        Unit
  conversionFactor    Float                @default(1.0)
  minimumStock        Float                @default(0)
  referenceCost       Float                @default(0)
  maxAcceptablePrice  Float?
  lastCostUpdate      DateTime?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  consumptionPatterns ConsumptionPattern[] @relation("ConsumptionPatterns")
  demandForecasts     DemandForecast[]     @relation("DemandForecasts")
  batches             IngredientBatch[]
  suppliers           IngredientSupplier[]
  category            IngredientCategory   @relation(fields: [categoryId], references: [id])
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoiceItems        InvoiceItem[]
  priceAlerts         PriceAlert[]
  priceTrends         PriceTrend[]
  recipeIngredients   RecipeIngredient[]
  stockForecasts      StockForecast[]      @relation("StockForecasts")
  stockMovements      StockMovement[]
  currentStock        Stock?
  priceSyncs          SupplierPriceSync[]
  wasteLogs           WasteLog[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("ingredients")
}

model Supplier {
  id            String                @id @default(cuid())
  restaurantId  String
  code          String
  name          String
  cnpj          String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  contactPerson String?
  status        SupplierStatus        @default(ACTIVE)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  ingredients   IngredientSupplier[]
  integrations  SupplierIntegration[]
  priceSyncs    SupplierPriceSync[]
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@unique([restaurantId, cnpj])
  @@index([restaurantId])
  @@map("suppliers")
}

model IngredientSupplier {
  id                String             @id @default(cuid())
  ingredientId      String
  supplierId        String?
  supplierName      String
  supplierCode      String?
  unitPrice         Float
  leadDays          Int                @default(1)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  ingredientBatches IngredientBatch[]
  ingredient        Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  priceAlerts       PriceAlert[]
  priceTrends       PriceTrend[]
  shoppingListItems ShoppingListItem[]

  @@map("ingredient_suppliers")
}

model SupplierIntegration {
  id              String          @id @default(cuid())
  supplierId      String
  integrationType IntegrationType
  apiKey          String?
  apiSecret       String?
  apiUrl          String?
  webhookUrl      String?
  webhookSecret   String?
  lastSyncedAt    DateTime?
  lastSyncStatus  SyncStatus      @default(PENDING)
  lastSyncError   String?
  syncFrequency   Int             @default(24)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, integrationType])
  @@map("supplier_integrations")
}

model SupplierPriceSync {
  id               String     @id @default(cuid())
  supplierId       String
  ingredientId     String
  lastFetchedPrice Decimal
  previousPrice    Decimal?
  lastFetchedAt    DateTime
  syncStatus       SyncStatus @default(PENDING)
  syncError        String?
  leadTime         Int?
  minimumOrder     Decimal?
  currency         String     @default("BRL")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier         Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@index([supplierId])
  @@index([ingredientId])
  @@map("supplier_price_syncs")
}

model Recipe {
  id               String                    @id @default(cuid())
  restaurantId     String
  code             String
  name             String
  description      String?
  baseYield        Float
  yieldUnit        Unit
  portionSize      Float                     @default(1)
  portionUnit      Unit
  prepTimeMinutes  Int                       @default(0)
  yieldLossFactor  Float                     @default(0.0)
  totalCost        Float                     @default(0)
  costPerPortion   Float                     @default(0)
  active           Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  sellingPrice     Float?
  menuEngSnapshots MenuEngineeringSnapshot[] @relation("RecipeMenuEngSnapshots")
  menuMappings     MenuItemMapping[]
  orderItems       OrderItem[]
  sessionItems     OrderSessionItem[]        @relation("OrderSessionItems")
  productionPlans  ProductionPlanItem[]
  ingredients      RecipeIngredient[]
  scales           RecipeScale[]
  posSaleItems     POSSaleItem[]
  menuItems        MenuItem[]                @relation("MenuItemRecipe")
  restaurant       Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("recipes")
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float
  unit         Unit
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeScale {
  id                String             @id @default(cuid())
  recipeId          String
  quantity          Float
  totalCost         Float
  createdAt         DateTime           @default(now())
  recipe            Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  scaledIngredients ScaledIngredient[]

  @@map("recipe_scales")
}

model ScaledIngredient {
  id           String      @id @default(cuid())
  scaleId      String
  ingredientId String
  quantity     Float
  unit         Unit
  cost         Float
  available    Boolean     @default(true)
  scale        RecipeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@map("scaled_ingredients")
}

model ProductionPlan {
  id                String               @id @default(cuid())
  restaurantId      String
  planDate          DateTime
  status            PlanStatus           @default(DRAFT)
  totalCost         Float                @default(0)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  consolidatedNeeds ConsolidatedNeed[]
  items             ProductionPlanItem[]
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, planDate])
  @@index([restaurantId])
  @@map("production_plans")
}

model ProductionPlanItem {
  id            String         @id @default(cuid())
  restaurantId  String
  planId        String
  recipeId      String
  quantity      Float
  estimatedCost Float
  status        ItemStatus     @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  plan          ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipe        Recipe         @relation(fields: [recipeId], references: [id])
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("production_plan_items")
}

model ConsolidatedNeed {
  id            String         @id @default(cuid())
  restaurantId  String
  planId        String
  ingredientId  String
  totalQuantity Float
  unit          Unit
  currentStock  Float
  shortage      Float
  suppliers     String
  createdAt     DateTime       @default(now())
  plan          ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, planId, ingredientId])
  @@index([restaurantId])
  @@map("consolidated_needs")
}

model Stock {
  restaurantId    String
  id              String     @id @default(cuid())
  ingredientId    String     @unique
  currentQuantity Float
  lastUpdated     DateTime   @default(now())
  lastAuditedAt   DateTime?
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, ingredientId])
  @@index([restaurantId])
  @@map("stocks")
}

model StockMovement {
  id            String       @id @default(cuid())
  restaurantId  String
  ingredientId  String
  quantity      Float
  movementType  MovementType
  reason        String?
  referenceId   String?
  referenceType String?
  createdAt     DateTime     @default(now())
  ingredient    Ingredient   @relation(fields: [ingredientId], references: [id])
  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([ingredientId])
  @@map("stock_movements")
}

model WasteLog {
  id            String      @id @default(cuid())
  restaurantId  String
  ingredientId  String
  quantity      Float
  unit          Unit
  estimatedCost Float       @default(0)
  reason        WasteReason
  notes         String?
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id])
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([ingredientId])
  @@map("waste_logs")
}

model InventoryAdjustment {
  id             String           @id @default(cuid())
  restaurantId   String
  adjustmentDate DateTime
  status         AdjustmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          AdjustmentItem[]
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("inventory_adjustments")
}

model AdjustmentItem {
  id           String              @id @default(cuid())
  restaurantId String
  adjustmentId String
  ingredientId String
  expectedQty  Float
  countedQty   Float
  difference   Float
  variance     Float
  adjustment   InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("adjustment_items")
}

model ShoppingList {
  id           String             @id @default(cuid())
  restaurantId String
  planId       String?
  listDate     DateTime
  status       ShoppingListStatus @default(PENDING)
  totalCost    Float              @default(0)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  items        ShoppingListItem[]
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("shopping_lists")
}

model ShoppingListItem {
  id             String              @id @default(cuid())
  restaurantId   String
  shoppingListId String
  ingredientId   String?
  supplierId     String?
  quantity       Float
  unit           Unit
  estimatedCost  Float
  actualCost     Float?
  priority       Priority            @default(MEDIUM)
  checked        Boolean             @default(false)
  notes          String?
  createdAt      DateTime            @default(now())
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shoppingList   ShoppingList        @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  supplier       IngredientSupplier? @relation(fields: [supplierId], references: [id])

  @@index([restaurantId])
  @@map("shopping_list_items")
}

model Alert {
  id           String     @id @default(cuid())
  restaurantId String
  type         AlertType
  severity     Severity   @default(MEDIUM)
  title        String
  message      String
  ingredientId String?
  recipeId     String?
  planId       String?
  dismissed    Boolean    @default(false)
  dismissedAt  DateTime?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model AlertPreference {
  id        String    @id @default(cuid())
  userId    String
  alertType AlertType
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, alertType])
  @@map("alert_preferences")
}

model AuditLog {
  id           String      @id @default(cuid())
  userId       String
  action       AuditAction
  entityType   String
  entityId     String
  changes      String
  ipAddress    String?
  createdAt    DateTime    @default(now())
  restaurantId String?
  restaurant   Restaurant? @relation("AuditLogs", fields: [restaurantId], references: [id])
  user         User        @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Invoice {
  id            String            @id @default(cuid())
  restaurantId  String
  fileName      String
  fileUrl       String
  uploadedAt    DateTime          @default(now())
  processedAt   DateTime?
  status        InvoiceStatus     @default(PENDING)
  supplierName  String?
  invoiceNumber String?
  invoiceDate   DateTime?
  totalAmount   Float?
  notes         String?
  isProcessed   Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         InvoiceItem[]
  ocrResult     InvoiceOCRResult?
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id           String      @id @default(cuid())
  invoiceId    String
  ingredientId String?
  description  String
  quantity     Float
  unit         String
  unitPrice    Float
  totalPrice   Float
  matched      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model InvoiceOCRResult {
  id             String   @id @default(cuid())
  invoiceId      String   @unique
  rawText        String
  extractedJSON  String
  confidence     Float    @default(0.0)
  processingTime Int      @default(0)
  modelUsed      String   @default("gpt-5.4-mini")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_ocr_results")
}

model PriceTrend {
  id           String              @id @default(cuid())
  restaurantId String
  ingredientId String
  supplierId   String?
  price        Float
  quantity     Float?
  source       PriceSource         @default(MANUAL)
  invoiceId    String?
  recordedDate DateTime
  createdAt    DateTime            @default(now())
  ingredient   Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier     IngredientSupplier? @relation(fields: [supplierId], references: [id])

  @@index([restaurantId])
  @@index([ingredientId])
  @@index([recordedDate])
  @@map("price_trends")
}

model PriceAlert {
  id              String              @id @default(cuid())
  restaurantId    String
  ingredientId    String
  supplierId      String?
  maxPrice        Float
  minPrice        Float?
  alertType       PriceAlertType
  enabled         Boolean             @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  ingredient      Ingredient          @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier        IngredientSupplier? @relation(fields: [supplierId], references: [id])

  @@unique([restaurantId, ingredientId, supplierId, alertType])
  @@index([restaurantId])
  @@index([ingredientId])
  @@map("price_alerts")
}

model StockForecast {
  id                  String     @id @default(cuid())
  restaurantId        String
  ingredientId        String
  currentStock        Decimal
  dailyConsumptionAvg Decimal
  daysUntilEmpty      Float
  confidenceLevel     Decimal    @default(0.95)
  riskLevel           RiskLevel  @default(LOW)
  suggestedReorderQty Decimal
  createdAt           DateTime   @default(now())
  forecastDate        DateTime
  ingredient          Ingredient @relation("StockForecasts", fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, ingredientId, forecastDate])
  @@index([restaurantId])
  @@index([ingredientId])
  @@index([riskLevel])
  @@map("stock_forecasts")
}

model ConsumptionPattern {
  id                  String     @id @default(cuid())
  restaurantId        String
  ingredientId        String
  dayOfWeek           Int?
  avgDailyConsumption Decimal
  minConsumption      Decimal
  maxConsumption      Decimal
  stdDeviation        Decimal
  samplesCount        Int        @default(1)
  lastUpdatedAt       DateTime   @default(now())
  ingredient          Ingredient @relation("ConsumptionPatterns", fields: [ingredientId], references: [id], onDelete: Cascade)
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, dayOfWeek])
  @@index([ingredientId])
  @@map("consumption_patterns")
}

model POSSettings {
  id                String      @id @default(cuid())
  restaurantId      String
  provider          POSProvider @default(STONE)
  squareAccessToken String?
  squareLocationId  String?
  squareMerchantId  String?
  sumupApiKey       String?
  sumupMerchantId   String?
  isConfigured      Boolean     @default(false)
  webhookSecret     String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deviceSerial      String?
  stoneApiKey       String?
  stoneMerchantId   String?
  stoneStoneCode    String?
  saiposApiKey      String?
  saiposStoreId     String?
  totvsTenantId     String?
  totvsApiKey       String?
  totvsUnitId       String?
  syncEnabled       Boolean     @default(true)
  lastSyncAt        DateTime?
  autoReconcile     Boolean     @default(true)
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, provider])
