  state           WhatsAppConversationState @default(GREETING)
  context         Json?
  cart            Json?
  cartTotal       Decimal                   @default(0)
  orderType       WhatsAppOrderType?
  deliveryAddress String?
  tableNumber     Int?
  customerNotes   String?
  orderSessionId  String?                   @unique
  lastMessageAt   DateTime                  @default(now())
  lastBotReplyAt  DateTime?
  closedAt        DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  orderSession    OrderSession?             @relation("WhatsAppOrderSession", fields: [orderSessionId], references: [id])
  restaurant      Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  messages        WhatsAppMessage[]

  @@unique([restaurantId, phoneNumber])
  @@index([restaurantId])
  @@index([state])
  @@index([phoneNumber])
  @@index([lastMessageAt])
  @@map("whatsapp_conversations")
}

