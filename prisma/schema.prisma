model MarketingLead {
  id              String            @id @default(cuid())
  restaurantId    String?
  source          LeadSource
  sourceDetail    String?           // e.g., campaign name, landing page URL, segment slug
  phoneNumber     String?
  email           String?
  name            String?
  businessName    String?
  segment         String?           // e.g., pizzaria, hamburgueria, delivery
  status          LeadStatus        @default(NEW)
  score           Int               @default(0)  // 0-100 lead score
  tags            String[]          @default([])
  notes           String?           @db.Text
  // Nurturing
  stage           LeadNurtureStage  @default(CAPTURED)
  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  contactAttempts Int               @default(0)
  convertedAt     DateTime?
  convertedUserId String?
  // UTM tracking
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  // Metadata
  metadata        Json?             @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  restaurant      Restaurant?       @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([status])
  @@index([stage])
  @@index([score])
  @@index([createdAt])
  @@index([phoneNumber])
  @@index([email])
  @@index([segment])
  @@index([restaurantId])
  @@map("marketing_leads")
}

